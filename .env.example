# ============================================
# Supabase (requerido cuando conectemos DB)
# ============================================
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ============================================
# PayPal (Fase 1 — pagos). Crear app en https://developer.paypal.com
# ============================================
PAYPAL_ENV=sandbox                 # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PUBLIC_PAYPAL_CLIENT_ID=           # mismo client_id, expuesto al browser para el SDK JS
PAYPAL_WEBHOOK_ID=                 # id del webhook para verificar la firma

# ============================================
# Email transaccional (Resend)
# ============================================
RESEND_API_KEY=re_...
FROM_EMAIL=hello@moresurfshop.com
ADMIN_EMAIL=admin@moresurfshop.com

# ============================================
# URL pública del sitio
# ============================================
PUBLIC_SITE_URL=https://moresurfshop.com

# ============================================
# WhatsApp Business (número internacional sin +, ni espacios)
# ============================================
PUBLIC_WHATSAPP_NUMBER=506XXXXXXXX
