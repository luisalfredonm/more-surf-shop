---
interface Props {
  as?: 'div' | 'section' | 'article';
  class?: string;
}
const { as: Tag = 'div', class: className = '' } = Astro.props;
---

<Tag class={`container ${className}`}>
  <slot />
</Tag>

<style>
  .container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
</style>
