---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`eyebrow ${className}`}><slot /></div>

<style>
  .eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--teal-dark);
    letter-spacing: 0.02em;
    margin-bottom: 1rem;
    text-transform: none;
  }
</style>
