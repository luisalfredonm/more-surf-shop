---
/**
 * Botón unificado con todas las variantes del diseño original.
 * Renderiza <a> si se pasa href, sino <button>.
 */
interface Props {
  variant?: 'primary' | 'dark' | 'outline' | 'secondary' | 'whatsapp';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  target?: string;
  rel?: string;
  class?: string;
  ariaLabel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  target,
  rel,
  class: className = '',
  ariaLabel,
} = Astro.props;

const isLink = Boolean(href);
const Tag = isLink ? 'a' : 'button';

// Auto rel para links externos
const computedRel = isLink && target === '_blank' ? rel || 'noopener noreferrer' : rel;

const classes = `btn btn-${variant} btn-size-${size} ${className}`;
---

<Tag
  class={classes}
  href={href}
  type={isLink ? undefined : type}
  target={target}
  rel={computedRel}
  aria-label={ariaLabel}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    transition: transform 150ms ease, background-color 150ms ease, box-shadow 150ms ease, color 150ms ease;
    font-family: 'Inter', sans-serif;
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn:active { transform: translateY(0); }
  .btn:focus-visible {
    outline: 3px solid var(--teal);
    outline-offset: 3px;
  }

  .btn-size-sm { padding: 0.625rem 1.125rem; font-size: 0.9rem; }
  .btn-size-md { padding: 0.875rem 1.75rem; font-size: 1rem; }
  .btn-size-lg { padding: 1.125rem 2.25rem; font-size: 1.0625rem; }

  .btn-primary {
    background: var(--sunset);
    color: var(--white);
    box-shadow: var(--shadow-md);
  }
  .btn-primary:hover {
    background: var(--sunset-dark);
    box-shadow: var(--shadow-lg);
  }

  .btn-dark {
    background: var(--navy);
    color: var(--white);
  }
  .btn-dark:hover { background: var(--navy-dark); }

  .btn-outline {
    background: transparent;
    color: var(--navy);
    border: 2px solid var(--navy);
  }
  .btn-outline:hover {
    background: var(--navy);
    color: var(--white);
  }

  .btn-secondary {
    background: var(--white);
    color: var(--navy);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }
  .btn-secondary:hover {
    border-color: var(--navy);
    box-shadow: var(--shadow-md);
  }

  .btn-whatsapp {
    background: #25D366;
    color: var(--white);
  }
  .btn-whatsapp:hover { background: #1DA851; }
</style>
