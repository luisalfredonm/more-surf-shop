---
import Container from '@components/ui/Container.astro';
import BookingFlow from '@components/booking/BookingFlow.tsx';
import { BUSINESS, whatsappUrl } from '@lib/constants';
import type { DbClassType } from '@lib/supabase';

interface Props {
  lessons: DbClassType[];
}

const { lessons } = Astro.props;

// Solo tipos con precio real llegan al wizard; el resto cae a WhatsApp.
const bookable = lessons
  .filter((l) => l.price_per_person > 0)
  .map((l) => ({
    id: l.id,
    name: l.name,
    price_per_person: l.price_per_person,
    ratio_label: l.ratio_label,
    badge: l.badge,
    description: l.description,
    included: l.included ?? [],
    min_guests: l.min_guests ?? 1,
    max_guests: l.max_guests,
  }));

const paypalClientId = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID ?? '';
const waHref = whatsappUrl('Hola! Quiero reservar una lección de surf en Tamarindo.');
---

<section class="section" id="book">
  <Container>
    <div class="bk-head">
      <span class="bk-eyebrow">Online booking</span>
      <h2>Reserve your surf session</h2>
      <p class="bk-sub">
        Choose your experience, pick a date and time, and pay online or on arrival.
        We'll send a confirmation email right away.
      </p>
    </div>

    {bookable.length > 0 ? (
      <BookingFlow
        client:visible
        classTypes={bookable}
        whatsappNumber={BUSINESS.whatsapp.number}
        paypalClientId={paypalClientId}
      />
    ) : (
      <div class="bk-fallback">
        <p>
          We're finishing loading prices and schedules. Message us and we'll set up your
          lesson right away.
        </p>
        <a class="bk-wa" href={waHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      </div>
    )}

    <noscript>
      <p class="bk-fallback">
        You need JavaScript to book online.
        <a href={waHref}>Message us on WhatsApp</a> instead.
      </p>
    </noscript>
  </Container>
</section>

<style>
  .section {
    padding: var(--section-pad) 0;
    border-top: 1px solid var(--border);
    background: var(--bg-alt);
  }
  .bk-head { text-align: center; max-width: 620px; margin: 0 auto 2.5rem; }
  .bk-eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal-dark);
  }
  .bk-head h2 { margin: 0.5rem 0 0.75rem; }
  .bk-sub { color: var(--text-muted); font-size: 1.05rem; margin: 0; }
  .bk-fallback {
    max-width: 620px;
    margin: 0 auto;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: center;
  }
  .bk-fallback .bk-wa {
    display: inline-block;
    margin-top: 1rem;
    background: #25d366;
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }
</style>
