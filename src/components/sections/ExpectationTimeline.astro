---
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';

const steps = [
  {
    n: '01',
    title: 'Check in at the shop',
    duration: '10 minutes',
    desc: 'Come by our shop at [meeting time]. We match you with a board, hand you a rash guard, and stow your bag in a locker. Bathrooms and changing rooms are on site.',
  },
  {
    n: '02',
    title: 'Beach briefing on land',
    duration: '20 minutes',
    desc: 'We walk across the sand to our lesson spot, right in front of the shop. Your instructor covers how the board works, the pop-up motion, what to do if a wave catches you, and how to read the lineup. We practice the pop-up on the sand a few times until it clicks.',
  },
  {
    n: '03',
    title: 'In the water, coach beside you',
    duration: '45–60 minutes',
    desc: "This is where it gets fun. Your instructor is right next to you, pushing you into your first waves, telling you when to paddle and pop up. Tamarindo's whitewater is soft and forgiving. Most beginners stand up on their first or second wave.",
  },
  {
    n: '04',
    title: 'Catching your own waves',
    duration: '20 minutes',
    desc: "Once you've stood up a few times, we start letting you paddle for waves yourself. Your coach is still there giving pointers, but now you're doing the reading, the timing, and the popping up on your own. This is the moment most people fall in love with surfing.",
  },
  {
    n: '05',
    title: "Debrief, shower, and what's next",
    duration: '10 minutes',
    desc: "Back at the shop, rinse off, change, and we go over what you did well and what to work on next. If you're around Tamarindo for a few more days, we suggest whether a second lesson or a board rental makes more sense for you. No pressure to book anything more.",
  },
];
---

<section class="section">
  <Container>
    <Eyebrow>Your first lesson</Eyebrow>
    <h2>What to Expect on Your First Surf Lesson</h2>
    <p class="section-intro">
      If you've never surfed before, here's exactly what your first two hours with us look
      like. No surprises.
    </p>

    <div class="timeline">
      {steps.map((step) => (
        <div class="timeline-step">
          <div class="step-number">{step.n}</div>
          <div class="step-content">
            <h3>{step.title}</h3>
            <span class="step-duration">{step.duration}</span>
            <p>{step.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>

<style>
  .section { padding: var(--section-pad) 0; }
  .section-intro {
    max-width: 640px;
    margin-bottom: 3rem;
    color: var(--text-muted);
    font-size: 1.125rem;
  }
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: relative;
    max-width: 800px;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 32px;
    top: 20px;
    bottom: 20px;
    width: 2px;
    background: var(--border);
    z-index: 0;
  }
  .timeline-step {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    position: relative;
    z-index: 1;
  }
  .step-number {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    background: var(--teal);
    color: var(--white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Fraunces', serif;
    font-size: 1.375rem;
    font-weight: 600;
    box-shadow: var(--shadow-md);
  }
  .step-content { padding-top: 0.5rem; }
  .step-content h3 { margin-bottom: 0.25rem; }
  .step-duration {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--teal-dark);
    font-weight: 600;
    margin-bottom: 0.5rem;
    background: var(--bg-alt);
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
  }
  .step-content p {
    color: var(--text);
    margin-top: 0.5rem;
  }
</style>
