---
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import WhatsAppIcon from '@components/ui/WhatsAppIcon.astro';
import { BUSINESS, whatsappUrl } from '@lib/constants';

const { latitude: lat, longitude: lon } = BUSINESS.geo;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lon}`;

// Mapa real de OpenStreetMap (sin API key). Antes esto era un div con
// gradiente y un emoji de pin, que no ubicaba a nadie.
const d = 0.006;
const bbox = [lon - d, lat - d * 0.75, lon + d, lat + d * 0.75].join('%2C');
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat}%2C${lon}`;

// TODO: confirmar horarios reales con el dueño antes de producción.
const hours = '7:00 AM to 6:00 PM, every day';
---

<section class="section" id="location">
  <Container>
    <div class="location">
      <div class="location-map">
        <iframe
          src={mapSrc}
          title="Map showing More Surf Shop on Tamarindo Beach"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      </div>
      <div class="location-info">
        <h2>Our Surf Shop in Tamarindo</h2>
        <p class="lead">
          A real, physical shop on Tamarindo Beach. Walk in, meet the team, see the boards,
          book on the spot.
        </p>
        <ul class="location-details">
          <li>
            <strong>Address</strong>
            <span>{BUSINESS.address.formatted}</span>
          </li>
          <li>
            <strong>Hours</strong>
            <span>{hours}</span>
          </li>
          <li>
            <strong>WhatsApp</strong>
            <span>{BUSINESS.whatsapp.display}</span>
          </li>
          <li>
            <strong>Email</strong>
            <span>{BUSINESS.email.main}</span>
          </li>
        </ul>
        <div class="location-actions">
          <Button variant="dark" href={directionsUrl} target="_blank">
            Get Directions
          </Button>
          <Button variant="whatsapp" href={whatsappUrl()} target="_blank">
            <WhatsAppIcon size={18} />
            WhatsApp Us
          </Button>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .section { padding: var(--section-pad) 0; }
  .location {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .location-map {
    aspect-ratio: 4 / 3;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .location-map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .lead {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .location-details {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .location-details li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    background: var(--bg-alt);
    border-radius: var(--radius-sm);
  }
  .location-details strong {
    color: var(--teal-dark);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .location-details span {
    color: var(--text);
    font-size: 0.9375rem;
  }
  .location-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 900px) {
    .location { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
