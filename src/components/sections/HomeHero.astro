---
import Button from '@components/ui/Button.astro';
import WhatsAppIcon from '@components/ui/WhatsAppIcon.astro';
import { whatsappUrl } from '@lib/constants';

/**
 * Hero de la home, la página "paraguas" de la marca.
 * Keyword objetivo: "surf shop tamarindo" (no "surf lessons").
 *
 * NOTE: la imagen se pasa por prop `image` para que coincida con el
 * <link rel="preload"> que emite BaseLayout (index.astro usa el mismo valor).
 * TODO: reemplazar por foto real de la tienda / playa Tamarindo.
 */
interface Props {
  image?: string;
}

const {
  image = 'https://images.unsplash.com/photo-1530870110042-98b2cb110834?w=1920&q=80&auto=format&fit=crop',
} = Astro.props;

const waMessage = "Hi! I'm planning a trip to Tamarindo and have a few questions.";
---

<section class="hero" role="region" aria-label="Hero">
  <div
    class="hero-bg"
    role="img"
    aria-label="Tamarindo Beach at sunset with surfers in the water"
    style={`background-image: linear-gradient(180deg, rgba(10, 37, 64, 0.35) 0%, rgba(10, 37, 64, 0.8) 100%), url('${image}');`}
  />
  <div class="hero-inner">
    <div class="hero-content">
      <span class="hero-tag">Family-run, on Tamarindo Beach</span>
      <h1>Your Local Surf Shop in Tamarindo, Costa Rica</h1>
      <p class="hero-sub">
        Surf lessons, board rentals, surf trips and Guanacaste tours, run by locals who surf
        this beach every day.
      </p>
      <div class="hero-ctas">
        <Button variant="primary" size="lg" href="#services">See What We Do</Button>
        <Button variant="secondary" size="lg" href={whatsappUrl(waMessage)} target="_blank">
          <WhatsAppIcon size={20} />
          WhatsApp us
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 660px;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--white);
    isolation: isolate;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .hero-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 5rem 1.5rem;
    width: 100%;
  }
  .hero-content { max-width: 820px; }
  .hero-tag {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: rgba(20, 184, 166, 0.25);
    border: 1px solid rgba(20, 184, 166, 0.5);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }
  .hero h1 {
    color: var(--white);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
    margin-bottom: 1.5rem;
  }
  .hero-sub {
    font-size: 1.25rem;
    line-height: 1.5;
    margin-bottom: 2.5rem;
    max-width: 660px;
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.2);
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  @media (max-width: 640px) {
    .hero { min-height: 560px; }
    .hero-sub { font-size: 1.0625rem; }
  }
</style>
