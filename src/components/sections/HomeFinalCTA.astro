---
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import WhatsAppIcon from '@components/ui/WhatsAppIcon.astro';
import { whatsappUrl } from '@lib/constants';

/**
 * CTA final de la home — genérico, orientado a planificar el viaje.
 * (La página de lecciones usa FinalCTA.astro, que incluye el LeadForm.)
 */
const waMessage =
  "Hi! I'm planning a trip to Tamarindo. Can you help me put together lessons, a board rental, and a tour?";
---

<section class="section">
  <Container>
    <div class="final-cta">
      <h2>Ready to Surf Tamarindo?</h2>
      <p class="lead">
        Message us with your dates. We'll build a trip that fits your group, your budget, and
        the conditions we're seeing on the beach this week.
      </p>
      <div class="final-cta-buttons">
        <Button variant="whatsapp" size="lg" href={whatsappUrl(waMessage)} target="_blank">
          <WhatsAppIcon size={20} />
          WhatsApp Us Now
        </Button>
        <a href="#services" class="btn-link">or see what we do →</a>
      </div>
    </div>
  </Container>
</section>

<style>
  .section { padding: var(--section-pad) 0; }
  .final-cta {
    background: linear-gradient(135deg, var(--navy) 0%, var(--navy-dark) 100%);
    border-radius: var(--radius);
    padding: 4rem 3rem;
    text-align: center;
    color: var(--white);
    position: relative;
    overflow: hidden;
  }
  .final-cta::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(20, 184, 166, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }
  .final-cta h2 {
    color: var(--white);
    margin-bottom: 1rem;
  }
  .final-cta .lead {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.125rem;
    max-width: 560px;
    margin: 0 auto 2rem;
  }
  .final-cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    align-items: center;
  }
  .btn-link {
    color: var(--teal);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .btn-link:hover { color: var(--white); }
  @media (max-width: 640px) {
    .final-cta { padding: 2.5rem 1.5rem; }
  }
</style>
