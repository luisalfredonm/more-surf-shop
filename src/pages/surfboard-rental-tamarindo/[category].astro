---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import WhatsAppIcon from '@components/ui/WhatsAppIcon.astro';
import FaqAccordion from '@components/sections/FaqAccordion.astro';
import FAQPageSchema from '@components/seo/FAQPageSchema.astro';
import BreadcrumbSchema from '@components/seo/BreadcrumbSchema.astro';
import CatalogGrid from '@components/rentals/CatalogGrid.tsx';
import { getCatalogUnits, getRentalCategory } from '@lib/queries/rentals';
import { surfboardRentalTamarindoFaqs } from '@data/faqs/surfboard-rental-tamarindo';
import { SITE, absoluteUrl, whatsappUrl } from '@lib/constants';
import type { PageSeo } from '@lib/seo';

export const prerender = false;

const { category } = Astro.params;
const cat = category ? getRentalCategory(category) : undefined;
if (!cat) return Astro.redirect('/surfboard-rental-tamarindo', 302);

const slug = `/surfboard-rental-tamarindo/${cat.slug}`;
const units = await getCatalogUnits(cat.slug);
const waHref = whatsappUrl(`Hi! I want to rent a ${cat.label.toLowerCase()} in Tamarindo.`);
const url = absoluteUrl(slug);

const seo: PageSeo = {
  slug,
  keyfocus: `${cat.label.toLowerCase()} rental tamarindo`,
  title: cat.title,
  description: cat.description,
  related: ['surfboard-rental-tamarindo', 'surf-lessons-tamarindo'],
  // Sin flota de este tipo: no indexar una página vacía.
  noindex: units.length === 0,
};

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: cat.h1,
  itemListElement: units.map((u, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: u.name,
      category: cat.label,
      ...(u.image ? { image: u.image } : {}),
      url: absoluteUrl(`/surfboard-rental-tamarindo/tabla/${u.slug}`),
      offers: {
        '@type': 'Offer',
        price: u.price_per_day,
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        url: absoluteUrl(`/surfboard-rental-tamarindo/tabla/${u.slug}`),
        seller: { '@id': `${SITE.url}/#business` },
      },
    },
  })),
};

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Surfboard Rental Tamarindo', path: '/surfboard-rental-tamarindo' },
  { name: cat.label, path: slug },
];
---

<BaseLayout seo={seo}>
  <Fragment slot="head">
    {units.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
    )}
    <FAQPageSchema faqs={surfboardRentalTamarindoFaqs} />
    <BreadcrumbSchema items={breadcrumbs} />
  </Fragment>

  <section class="rc-hero">
    <Container>
      <nav class="rc-crumb">
        <a href="/surfboard-rental-tamarindo">Alquiler de tablas</a> <span>/</span> {cat.label}
      </nav>
      <h1>{cat.h1}</h1>
      <p class="rc-lead">{cat.intro}</p>
    </Container>
  </section>

  <section class="rc-catalog">
    <Container>
      {units.length > 0 ? (
        <CatalogGrid client:load units={units} initialCategory={cat.slug} />
      ) : (
        <div class="rc-fallback">
          <p>No tenemos {cat.label.toLowerCase()} en la flota ahora mismo. Escribinos y quizá conseguimos una.</p>
          <div class="rc-cta">
            <Button href="/surfboard-rental-tamarindo" size="lg">Ver todas las tablas</Button>
            <Button variant="whatsapp" size="lg" href={waHref} target="_blank">
              <WhatsAppIcon size={20} />
              WhatsApp
            </Button>
          </div>
        </div>
      )}
    </Container>
  </section>

  <FaqAccordion
    faqs={surfboardRentalTamarindoFaqs}
    title="Alquiler de tablas en Tamarindo: preguntas frecuentes"
    intro="Lo que más nos preguntan antes de alquilar."
  />
</BaseLayout>

<style>
  .rc-hero {
    padding: 3.5rem 0 2rem;
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
  }
  .rc-crumb {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }
  .rc-crumb a { color: var(--teal-dark); text-decoration: none; }
  .rc-crumb span { margin: 0 0.4rem; }
  .rc-lead {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 60ch;
    margin: 0.9rem 0 0;
  }
  .rc-catalog { padding: 2rem 0 var(--section-pad); }
  .rc-fallback {
    max-width: 560px;
    margin: 2rem auto;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: center;
  }
  .rc-fallback p { color: var(--text-muted); margin: 0 0 1.25rem; }
  .rc-cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
</style>
