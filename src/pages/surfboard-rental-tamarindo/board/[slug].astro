---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import BreadcrumbSchema from '@components/seo/BreadcrumbSchema.astro';
import BoardAvailability from '@components/rentals/BoardAvailability.tsx';
import { getCatalogUnit } from '@lib/queries/rentals';
import { SITE, absoluteUrl } from '@lib/constants';
import type { PageSeo } from '@lib/seo';

export const prerender = false;

const { slug } = Astro.params;
const unit = slug ? await getCatalogUnit(slug) : null;
if (!unit) return Astro.redirect('/surfboard-rental-tamarindo', 302);

const CATEGORY_LABEL: Record<string, string> = {
  softtop: 'Soft-top',
  longboard: 'Longboard',
  funboard: 'Funboard',
  shortboard: 'Shortboard',
  fish: 'Fish',
  sup: 'SUP',
};
const LEVEL_LABEL: Record<string, string> = {
  beginner: 'Beginner',
  intermediate: 'Intermediate',
  advanced: 'Advanced',
  all: 'All levels',
};

const cat = CATEGORY_LABEL[unit.category] ?? unit.category;
const path = `/surfboard-rental-tamarindo/board/${unit.slug}`;
const url = absoluteUrl(path);
const money = (n: number) => `$${Number(n).toFixed(0)}`;
const week = Math.round(unit.price_per_day * 7);

const seo: PageSeo = {
  slug: path,
  keyfocus: `${unit.name} rental tamarindo`,
  title: `${unit.name} rental | More Surf Shop Tamarindo`,
  description:
    (unit.description ?? `Rent a ${unit.name} on Playa Tamarindo.`).slice(0, 150) +
    ` ${money(unit.price_per_day)} per day.`,
  ogImage: unit.image ?? undefined,
  related: ['surfboard-rental-tamarindo'],
};

const allSpecs: [string, string][] = [
  ['Length', unit.length_label ?? '-'],
  ['Width', unit.width_in != null ? `${unit.width_in}"` : '-'],
  ['Thickness', unit.thickness_in != null ? `${unit.thickness_in}"` : '-'],
  ['Volume', unit.volume_l != null ? `${unit.volume_l} L` : '-'],
  ['Fins', unit.fin_setup ?? '-'],
  ['Construction', unit.construction ?? '-'],
];
const specs = allSpecs.filter(([, v]) => v !== '-');

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: unit.name,
  category: cat,
  ...(unit.description ? { description: unit.description } : {}),
  ...(unit.image ? { image: unit.image } : {}),
  offers: {
    '@type': 'Offer',
    price: unit.price_per_day,
    priceCurrency: 'USD',
    availability: unit.busy_until
      ? 'https://schema.org/PreOrder'
      : 'https://schema.org/InStock',
    url,
    seller: { '@id': `${SITE.url}/#business` },
  },
};

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Surfboard Rental Tamarindo', path: '/surfboard-rental-tamarindo' },
  { name: unit.name, path },
];
---

<BaseLayout seo={seo}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    <BreadcrumbSchema items={breadcrumbs} />
  </Fragment>

  <section class="bd">
    <Container>
      <a class="bd-back" href="/surfboard-rental-tamarindo">← Back to catalog</a>

      <div class="bd-top">
        <div class="bd-photo">
          {unit.image ? (
            <img src={unit.image} alt={unit.name} />
          ) : (
            <span class="bd-nophoto"><b>+</b>Photo coming soon</span>
          )}
        </div>

        <div class="bd-info">
          <span class="bd-cat">{cat}</span>
          <h1>{unit.name}</h1>
          {unit.nickname && <p class="bd-nick">“{unit.nickname}” · board {unit.code}</p>}
          <p class="bd-price">
            <strong>{money(unit.price_per_day)}</strong> per day
            <span> · {money(week)} per week</span>
          </p>
          {unit.description && <p class="bd-desc">{unit.description}</p>}

          <BoardAvailability
            client:load
            unit={{
              unit_id: unit.id,
              slug: unit.slug,
              name: unit.name,
              code: unit.code,
              image: unit.image,
              price_per_day: unit.price_per_day,
            }}
          />
        </div>
      </div>

      <div class="bd-bottom">
        {specs.length > 0 && (
          <div>
            <h2>Specs</h2>
            <dl class="bd-specs">
              {specs.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        <div>
          <h2>Is this your board?</h2>
          <ul class="bd-fit">
            <li><strong>Level:</strong> {LEVEL_LABEL[unit.skill_level] ?? unit.skill_level}</li>
            {unit.weight_min_kg && unit.weight_max_kg && (
              <li><strong>Recommended weight:</strong> {unit.weight_min_kg}-{unit.weight_max_kg} kg</li>
            )}
            {unit.best_for.length > 0 && (
              <li><strong>Best for:</strong> {unit.best_for.join(', ')}</li>
            )}
            {unit.features.length > 0 && (
              <li><strong>Includes:</strong> {unit.features.join(', ')}</li>
            )}
          </ul>
          <p class="bd-guar">
            At pickup you leave a card copy as our guarantee and sign the waiver at the counter.
            Fins and leash are included.
          </p>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .bd { padding: 2.5rem 0 var(--section-pad); }
  .bd-back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--teal-dark);
    text-decoration: none;
  }
  .bd-top {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .bd-top { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  .bd-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--bg-alt);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .bd-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bd-nophoto {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  .bd-nophoto b { font-size: 2.5rem; line-height: 1; color: var(--teal); }
  .bd-cat {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .bd-info h1 { margin: 0.35rem 0 0.25rem; }
  .bd-nick { color: var(--text-muted); font-size: 0.9rem; margin: 0 0 0.75rem; }
  .bd-price { margin: 0.5rem 0 1rem; color: var(--text-muted); }
  .bd-price strong {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 2rem;
    color: var(--teal-dark);
    margin-right: 0.3rem;
  }
  .bd-desc { color: var(--text); margin: 0 0 1.5rem; line-height: 1.6; }
  .bd-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }
  @media (max-width: 860px) {
    .bd-bottom { grid-template-columns: 1fr; gap: 2rem; }
  }
  .bd-bottom h2 { font-size: 1.25rem; margin: 0 0 1rem; }
  /* Fichas en grid, no una tabla con hairline por fila. */
  .bd-specs {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  .bd-specs > div {
    background: var(--bg-alt);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
  }
  .bd-specs dt {
    margin: 0 0 0.25rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .bd-specs dd {
    margin: 0;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.35rem;
    line-height: 1.1;
    color: var(--navy);
  }
  @media (max-width: 420px) {
    .bd-specs { grid-template-columns: 1fr; }
  }
  .bd-fit { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .bd-fit li { font-size: 0.95rem; color: var(--text-muted); }
  .bd-fit strong { color: var(--navy); }
  .bd-guar { margin-top: 1.25rem; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6; }
</style>
