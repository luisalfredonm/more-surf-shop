---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Button from '@components/ui/Button.astro';
import WhatsAppIcon from '@components/ui/WhatsAppIcon.astro';
import FaqAccordion from '@components/sections/FaqAccordion.astro';
import FAQPageSchema from '@components/seo/FAQPageSchema.astro';
import BreadcrumbSchema from '@components/seo/BreadcrumbSchema.astro';
import ShopGrid from '@components/shop/ShopGrid.tsx';
import CartBar from '@components/shop/CartBar.tsx';
import { Icon } from 'astro-icon/components';
import { getPageSeo } from '@lib/seo';
import { getShopProducts, SHOP_CATEGORIES } from '@lib/queries/shop';
import { surfShopTamarindoFaqs } from '@data/faqs/surf-shop-tamarindo';
import { BUSINESS, SITE, absoluteUrl, whatsappUrl } from '@lib/constants';

export const prerender = false;

const seo = getPageSeo('surf-shop-tamarindo')!;
const products = await getShopProducts();
const waHref = whatsappUrl('Hi! I want to know what surf gear you have in stock.');
const url = absoluteUrl('/surf-shop-tamarindo');

const inStock = products.filter((p) => p.available > 0);
const from = inStock.length ? Math.min(...inStock.map((p) => p.price_from)) : 0;

// Categorías que realmente tienen producto cargado, con su conteo en vitrina.
const counts = new Map<string, number>();
for (const p of inStock) counts.set(p.category, (counts.get(p.category) ?? 0) + 1);
const cats = SHOP_CATEGORIES.filter((c) => counts.has(c.slug)).map((c) => ({
  ...c,
  count: counts.get(c.slug)!,
}));

// Una sola marquesina en la página. Son hechos, no eslóganes.
const strip = [
  { icon: 'ph:storefront', text: 'Pick up on Tamarindo Beach' },
  { icon: 'ph:credit-card', text: 'PayPal now or pay at the counter' },
  { icon: 'ph:package', text: 'We hold your order 48 hours' },
  { icon: 'ph:leaf', text: 'Reef-safe sunscreen only' },
  { icon: 'ph:sun-horizon', text: 'Open every day' },
];

const steps = [
  {
    n: '01',
    title: 'Pick what you need',
    text: 'Everything on this page is counted off the shelf in the shop. If it shows here, it is here.',
  },
  {
    n: '02',
    title: 'Pay now or later',
    text: 'Check out with PayPal, or reserve it and pay cash or card when you walk in.',
  },
  {
    n: '03',
    title: 'Collect it in the shop',
    text: `${BUSINESS.address.formatted}. Give us your order number at the counter and it is bagged in a minute.`,
  },
];

const heroPhoto =
  'https://images.unsplash.com/photo-1509914398892-963f53e6e2f1?w=1200&q=80&auto=format&fit=crop';

const storeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  '@id': `${url}#store`,
  name: 'More Surf Shop — Surf Accessories in Tamarindo',
  description:
    'Surf accessories on Tamarindo Beach: wax, leashes, fins, rash guards, reef-safe sunscreen, dry bags and board bags.',
  url,
  parentOrganization: { '@id': `${SITE.url}/#business` },
  areaServed: { '@type': 'Place', name: 'Tamarindo, Guanacaste, Costa Rica' },
  ...(inStock.length
    ? {
        makesOffer: {
          '@type': 'AggregateOffer',
          priceCurrency: 'USD',
          lowPrice: from,
          highPrice: Math.max(...inStock.map((p) => p.price_to)),
          offerCount: inStock.length,
          availability: 'https://schema.org/InStock',
        },
      }
    : {}),
};

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Surf Shop Tamarindo', path: '/surf-shop-tamarindo' },
];
---

<BaseLayout seo={seo}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(storeSchema)} />
    <FAQPageSchema faqs={surfShopTamarindoFaqs} />
    <BreadcrumbSchema items={breadcrumbs} />
  </Fragment>

  <section class="ss-hero">
    <Container>
      <div class="ss-hero-grid">
        <div class="ss-hero-copy">
          <Eyebrow>Surf shop · Playa Tamarindo</Eyebrow>
          <h1>The stuff you forgot to pack</h1>
          <p class="ss-lead">
            Wax, leashes, fins, rash guards and reef-safe sunscreen. What you see here is what is
            on the shelf today, counted by the same people who hand it to you.
          </p>
          <div class="ss-cta">
            <Button href="#catalog" size="lg">Browse the shop</Button>
            <Button variant="whatsapp" size="lg" href={waHref} target="_blank">
              <WhatsAppIcon size={20} />
              Ask on WhatsApp
            </Button>
          </div>

          {inStock.length > 0 && (
            <dl class="ss-stats">
              <div>
                <dt>On the shelf</dt>
                <dd>{inStock.length}</dd>
              </div>
              <div>
                <dt>From</dt>
                <dd>${from.toFixed(0)}</dd>
              </div>
              <div>
                <dt>Pickup</dt>
                <dd>Same day</dd>
              </div>
            </dl>
          )}
        </div>

        <figure class="ss-hero-photo">
          <img
            src={heroPhoto}
            alt="A surfer sitting on a board at sunset off Playa Tamarindo"
            width="1200"
            height="900"
            fetchpriority="high"
          />
          <figcaption>Playa Tamarindo, Guanacaste</figcaption>
        </figure>
      </div>
    </Container>
  </section>

  <div class="ss-strip" aria-hidden="true">
    <div class="ss-strip-track">
      {/* La segunda copia es la que hace el loop continuo; sin movimiento sobra. */}
      {[0, 1].map((copy) =>
        strip.map((s) => (
          <span class={`ss-strip-item ${copy === 1 ? 'is-dupe' : ''}`}>
            <Icon name={s.icon} />
            {s.text}
          </span>
        )),
      )}
    </div>
  </div>

  {cats.length > 0 && (
    <section class="ss-cats">
      <Container>
        <div class="ss-sec-head">
          <Eyebrow>Shop by shelf</Eyebrow>
          <h2>What we keep in stock</h2>
        </div>
        <div class="ss-cat-grid">
          {cats.map((c, i) => (
            <a class="ss-cat" href={`/surf-shop-tamarindo/${c.slug}`}>
              <span class="ss-cat-ghost" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <strong>{c.label}</strong>
              <span class="ss-cat-blurb">{c.blurb}</span>
              <span class="ss-cat-foot">
                {c.count} {c.count === 1 ? 'product' : 'products'}
                <Icon name="ph:arrow-right" />
              </span>
            </a>
          ))}
        </div>
      </Container>
    </section>
  )}

  <section class="ss-catalog" id="catalog">
    <Container>
      <div class="ss-sec-head ss-sec-head-split">
        <div>
          <h2>Everything we stock</h2>
          <p>
            Live from the shop floor. Prices include tax, and you collect it on Tamarindo Beach.
          </p>
        </div>
        <a class="ss-head-link" href={waHref} target="_blank" rel="noopener noreferrer">
          Looking for something else?
        </a>
      </div>

      {products.length > 0 ? (
        <ShopGrid client:load products={products} categories={SHOP_CATEGORIES} />
      ) : (
        <div class="ss-fallback">
          <p>
            We're still loading the shelves into the site. Message us and we'll tell you what we
            have today.
          </p>
          <a class="ss-wa" href={waHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </div>
      )}
    </Container>
  </section>

  <section class="ss-how">
    <Container>
      <h2>How buying here works</h2>
      <ol class="ss-steps">
        {steps.map((s) => (
          <li>
            <span class="ss-step-n">{s.n}</span>
            <strong>{s.title}</strong>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </Container>
  </section>

  <FaqAccordion
    faqs={surfShopTamarindoFaqs}
    title="Buying surf gear in Tamarindo: FAQ"
    intro="What people ask before walking over. If yours isn't here, message us on WhatsApp."
  />

  <section class="ss-final">
    <Container>
      <h2>Come by the shop</h2>
      <p>{BUSINESS.address.formatted}. Open every day.</p>
      <div class="ss-cta">
        <Button variant="whatsapp" size="lg" href={waHref} target="_blank">
          <WhatsAppIcon size={20} />
          Message us on WhatsApp
        </Button>
        <Button variant="outline" size="lg" href="/surfboard-rental-tamarindo">
          Rent a board instead
        </Button>
      </div>
    </Container>
  </section>

  <CartBar client:load />
</BaseLayout>

<style>
  /* ---------- Hero: split, no centrado ---------- */
  .ss-hero {
    padding: 3.5rem 0 3rem;
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
  }
  .ss-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 3.5rem;
    align-items: stretch;
  }
  .ss-hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .ss-hero h1 {
    max-width: 14ch;
    margin: 0;
  }
  .ss-lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 44ch;
    margin: 1.1rem 0 1.75rem;
  }
  .ss-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ss-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2.25rem;
    margin: 2.25rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .ss-stats dt {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .ss-stats dd {
    margin: 0.2rem 0 0;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--navy);
  }

  .ss-hero-photo {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .ss-hero-photo img {
    width: 100%;
    height: 100%;
    min-height: 24rem;
    object-fit: cover;
  }
  .ss-hero-photo figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2.5rem 1.25rem 1rem;
    background: linear-gradient(to top, rgba(6, 26, 46, 0.72), transparent);
    color: #fff;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ---------- Marquesina (una sola en la página) ---------- */
  .ss-strip {
    overflow: hidden;
    background: var(--sunset);
    color: #fff;
    padding: 0.85rem 0;
  }
  .ss-strip-track {
    display: flex;
    width: max-content;
    animation: ss-slide 42s linear infinite;
  }
  .ss-strip-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1.75rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .ss-strip-item [data-icon] { font-size: 1.05rem; }
  @keyframes ss-slide {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ss-strip-track {
      animation: none;
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 0.4rem;
    }
    .ss-strip-item.is-dupe { display: none; }
  }

  /* ---------- Cabeceras de sección ---------- */
  .ss-sec-head { margin-bottom: 2rem; }
  .ss-sec-head h2 { margin: 0 0 0.4rem; }
  .ss-sec-head p { color: var(--text-muted); margin: 0; max-width: 58ch; }
  .ss-sec-head-split {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .ss-head-link {
    color: var(--teal-dark);
    font-weight: 600;
    font-size: 0.92rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    white-space: nowrap;
  }
  .ss-head-link:hover { color: var(--navy); }

  /* ---------- Categorías: mosaico escalonado ---------- */
  .ss-cats { padding: var(--section-pad) 0 0; }
  .ss-cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
    align-items: start;
  }
  .ss-cat {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-height: 12.5rem;
    padding: 1.4rem 1.5rem 1.2rem;
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: inherit;
    transition:
      border-color 200ms ease,
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 260ms ease;
  }
  .ss-cat:hover {
    border-color: var(--teal);
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .ss-cat:active { transform: translateY(-1px); }
  /* El numeral vive arriba a la derecha: abajo chocaba con el pie de la
     tarjeta y se cortaba a media letra. */
  .ss-cat-ghost {
    position: absolute;
    top: 0.5rem;
    right: 1rem;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 3.25rem;
    line-height: 1;
    color: var(--bg-alt);
    pointer-events: none;
  }
  .ss-cat strong {
    position: relative;
    padding-right: 3rem;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.25rem;
    color: var(--navy);
  }
  .ss-cat-blurb {
    position: relative;
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
    max-width: 26ch;
  }
  .ss-cat-foot {
    position: relative;
    margin-top: auto;
    padding-top: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--teal-dark);
  }
  .ss-cat-foot [data-icon] {
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ss-cat:hover .ss-cat-foot [data-icon] { transform: translateX(4px); }

  /* ---------- Catálogo ---------- */
  .ss-catalog { padding: var(--section-pad) 0 0; }

  .ss-fallback {
    max-width: 560px;
    margin: 2rem auto;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: center;
  }
  .ss-wa {
    display: inline-block;
    margin-top: 1rem;
    background: #25d366;
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  /* ---------- Cómo funciona: pasos, no tarjetas ---------- */
  .ss-how { padding: var(--section-pad) 0 0; }
  .ss-how h2 { margin: 0 0 1.75rem; }
  .ss-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0;
    border-top: 1px solid var(--border);
  }
  .ss-steps li {
    padding: 1.5rem 1.75rem 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .ss-step-n {
    display: block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--sunset-dark);
    margin-bottom: 0.6rem;
  }
  .ss-steps strong {
    display: block;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.15rem;
    color: var(--navy);
    margin-bottom: 0.35rem;
  }
  .ss-steps p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 34ch;
  }

  /* ---------- Cierre ---------- */
  .ss-final {
    margin-top: var(--section-pad);
    padding: 3.5rem 0;
    text-align: center;
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
  }
  .ss-final p { color: var(--text-muted); margin: 0.5rem 0 1.5rem; }
  .ss-final .ss-cta { justify-content: center; }

  @media (prefers-reduced-motion: reduce) {
    .ss-cat,
    .ss-cat-foot [data-icon] {
      transition: none;
    }
    .ss-cat:hover { transform: none; }
    .ss-cat:hover .ss-cat-foot [data-icon] { transform: none; }
  }

  @media (max-width: 900px) {
    .ss-hero-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .ss-hero h1 { max-width: 18ch; }
    .ss-hero-photo img {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
  }
  @media (max-width: 640px) {
    .ss-stats { gap: 1.5rem; }
    .ss-stats dd { font-size: 1.35rem; }
    .ss-cat { min-height: 0; }
    .ss-steps li { padding-right: 0; }
  }
</style>
