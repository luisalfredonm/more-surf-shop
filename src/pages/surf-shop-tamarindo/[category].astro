---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import WhatsAppIcon from '@components/ui/WhatsAppIcon.astro';
import FaqAccordion from '@components/sections/FaqAccordion.astro';
import FAQPageSchema from '@components/seo/FAQPageSchema.astro';
import BreadcrumbSchema from '@components/seo/BreadcrumbSchema.astro';
import ShopGrid from '@components/shop/ShopGrid.tsx';
import { getShopProducts, getShopCategory, SHOP_CATEGORIES } from '@lib/queries/shop';
import { surfShopTamarindoFaqs } from '@data/faqs/surf-shop-tamarindo';
import { SITE, absoluteUrl, whatsappUrl } from '@lib/constants';
import type { PageSeo } from '@lib/seo';

export const prerender = false;

const { category } = Astro.params;
const cat = category ? getShopCategory(category) : undefined;
if (!cat) return Astro.redirect('/surf-shop-tamarindo', 302);

const slug = `/surf-shop-tamarindo/${cat.slug}`;
const products = await getShopProducts(cat.slug);
const waHref = whatsappUrl(`Hi! I'm looking for ${cat.label.toLowerCase()} in Tamarindo.`);
const url = absoluteUrl(slug);

const seo: PageSeo = {
  slug,
  keyfocus: `${cat.label.toLowerCase()} tamarindo`,
  title: cat.title,
  description: cat.description,
  related: ['surf-shop-tamarindo', 'surfboard-rental-tamarindo'],
  // Sin producto de esta categoría: no indexar una página vacía.
  noindex: products.length === 0,
};

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: cat.h1,
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.name,
      category: cat.label,
      ...(p.brand ? { brand: { '@type': 'Brand', name: p.brand } } : {}),
      ...(p.image ? { image: p.image } : {}),
      url: absoluteUrl(`/surf-shop-tamarindo/product/${p.slug}`),
      offers: {
        '@type': 'Offer',
        price: p.price_from,
        priceCurrency: 'USD',
        availability:
          p.available > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
        url: absoluteUrl(`/surf-shop-tamarindo/product/${p.slug}`),
        seller: { '@id': `${SITE.url}/#business` },
      },
    },
  })),
};

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Surf Shop Tamarindo', path: '/surf-shop-tamarindo' },
  { name: cat.label, path: slug },
];
---

<BaseLayout seo={seo}>
  <Fragment slot="head">
    {products.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
    )}
    <FAQPageSchema faqs={surfShopTamarindoFaqs} />
    <BreadcrumbSchema items={breadcrumbs} />
  </Fragment>

  <section class="sc-hero">
    <Container>
      <nav class="sc-crumb">
        <a href="/surf-shop-tamarindo">Surf shop</a> <span>/</span> {cat.label}
      </nav>
      <h1>{cat.h1}</h1>
      <p class="sc-intro">{cat.intro}</p>
    </Container>
  </section>

  <section class="sc-catalog">
    <Container>
      {products.length > 0 ? (
        <ShopGrid
          client:load
          products={products}
          categories={SHOP_CATEGORIES}
          activeCategory={cat.slug}
        />
      ) : (
        <div class="sc-fallback">
          <p>
            We don't have {cat.label.toLowerCase()} on the site right now. Message us — we may
            still have some at the counter.
          </p>
          <a class="sc-wa" href={waHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </div>
      )}

      <nav class="sc-others">
        <span>Also in the shop:</span>
        {SHOP_CATEGORIES.filter((c) => c.slug !== cat.slug).map((c) => (
          <a href={`/surf-shop-tamarindo/${c.slug}`}>{c.label}</a>
        ))}
      </nav>
    </Container>
  </section>

  <FaqAccordion
    faqs={surfShopTamarindoFaqs}
    title="Buying surf gear in Tamarindo: FAQ"
    intro="What people ask before walking over. If yours isn't here, message us on WhatsApp."
  />

  <section class="sc-final">
    <Container>
      <h2>Come by the shop</h2>
      <p>We're on Playa Tamarindo, open every day.</p>
      <Button variant="whatsapp" size="lg" href={waHref} target="_blank">
        <WhatsAppIcon size={20} />
        Message us on WhatsApp
      </Button>
    </Container>
  </section>
</BaseLayout>

<style>
  .sc-hero {
    padding: 3rem 0 2rem;
    background: var(--bg-alt);
  }
  .sc-crumb {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }
  .sc-crumb a { color: var(--teal-dark); text-decoration: none; }
  .sc-crumb a:hover { text-decoration: underline; }
  .sc-crumb span { margin: 0 0.35rem; }
  .sc-intro {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 60ch;
    margin: 1rem 0 0;
    line-height: 1.6;
  }

  .sc-catalog { padding: 2.5rem 0 var(--section-pad); }

  .sc-fallback {
    max-width: 560px;
    margin: 1rem auto 2rem;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: center;
  }
  .sc-wa {
    display: inline-block;
    margin-top: 1rem;
    background: #25d366;
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .sc-others {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: baseline;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
  .sc-others span { color: var(--text-muted); }
  .sc-others a { color: var(--teal-dark); text-decoration: none; font-weight: 600; }
  .sc-others a:hover { text-decoration: underline; }

  .sc-final {
    padding: 3.5rem 0;
    text-align: center;
    border-top: 1px solid var(--border);
  }
  .sc-final p { color: var(--text-muted); margin: 0.5rem 0 1.5rem; }
</style>
