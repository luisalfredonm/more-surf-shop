---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Button from '@components/ui/Button.astro';
import WhatsAppIcon from '@components/ui/WhatsAppIcon.astro';
import FaqAccordion from '@components/sections/FaqAccordion.astro';
import FAQPageSchema from '@components/seo/FAQPageSchema.astro';
import BreadcrumbSchema from '@components/seo/BreadcrumbSchema.astro';
import CatalogGrid from '@components/rentals/CatalogGrid.tsx';
import { getPageSeo } from '@lib/seo';
import { getCatalogUnits } from '@lib/queries/rentals';
import { surfboardRentalTamarindoFaqs } from '@data/faqs/surfboard-rental-tamarindo';
import { BUSINESS, SITE, absoluteUrl, whatsappUrl } from '@lib/constants';

export const prerender = false;

const seo = getPageSeo('surfboard-rental-tamarindo')!;
const units = await getCatalogUnits();
const waHref = whatsappUrl('Hi! I want to rent a surfboard in Tamarindo.');

const url = absoluteUrl('/surfboard-rental-tamarindo');
const from = units.length ? Math.min(...units.map((u) => u.price_per_day)) : 0;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Surfboard Rental in Tamarindo',
  description:
    'Rent surfboards on Tamarindo Beach — soft-tops, longboards, funboards, shortboards and fish. Daily and weekly rates. Reserve online or walk in.',
  serviceType: 'Surfboard Rental',
  url,
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: { '@type': 'Place', name: 'Tamarindo, Guanacaste, Costa Rica' },
  ...(units.length
    ? {
        offers: {
          '@type': 'AggregateOffer',
          priceCurrency: 'USD',
          lowPrice: from,
          highPrice: Math.max(...units.map((u) => u.price_per_day)),
          offerCount: units.length,
          availability: 'https://schema.org/InStock',
        },
      }
    : {}),
};

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Surfboard Rental Tamarindo', path: '/surfboard-rental-tamarindo' },
];
---

<BaseLayout seo={seo}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <FAQPageSchema faqs={surfboardRentalTamarindoFaqs} />
    <BreadcrumbSchema items={breadcrumbs} />
  </Fragment>

  <section class="rr-hero">
    <Container>
      <div class="rr-hero-in">
        <div>
          <Eyebrow>Alquiler de tablas · Playa Tamarindo</Eyebrow>
          <h1>Elegí tu tabla y llevátela hoy</h1>
          <p class="rr-lead">
            Softtops para aprender, longboards y funboards para pasarla bien, shortboards y fish
            para el que ya lee la ola. Por hora, por día o por semana. Reservá la tabla exacta
            desde acá o pasá por la tienda.
          </p>
          <div class="rr-hero-cta">
            <Button href="#tablas" size="lg">Ver las tablas</Button>
            <Button variant="whatsapp" size="lg" href={waHref} target="_blank">
              <WhatsAppIcon size={20} />
              Preguntar por WhatsApp
            </Button>
          </div>
        </div>
        <ol class="rr-steps">
          <li><strong>Elegí la tabla.</strong> Filtrá por tu peso, tu nivel y tu presupuesto.</li>
          <li><strong>Mirá si está libre.</strong> Poné las fechas y la añadís a tu reserva.</li>
          <li><strong>Retirala en la playa.</strong> Documento con foto, firmás el waiver y al agua.</li>
        </ol>
      </div>
    </Container>
  </section>

  <section class="rr-catalog" id="tablas">
    <Container>
      <div class="rr-cat-head">
        <h2>Todas nuestras tablas</h2>
        <p>Filtrá por lo que importa: tu nivel, tu presupuesto y el volumen que necesitás.</p>
      </div>

      {units.length > 0 ? (
        <CatalogGrid client:load units={units} />
      ) : (
        <div class="rr-fallback">
          <p>Estamos cargando la flota. Escribinos y te decimos qué tenemos libre hoy.</p>
          <a class="rr-wa" href={waHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </div>
      )}
    </Container>
  </section>

  <FaqAccordion
    faqs={surfboardRentalTamarindoFaqs}
    title="Alquiler de tablas en Tamarindo: preguntas frecuentes"
    intro="Lo que más nos preguntan antes de alquilar. Si falta la tuya, escribinos por WhatsApp."
  />

  <section class="rr-final">
    <Container>
      <h2>¿Preferís pasar por la tienda?</h2>
      <p>Estamos en {BUSINESS.address.formatted}. Abierto todos los días.</p>
      <div class="rr-hero-cta">
        <Button href="#tablas" size="lg">Reservar una tabla</Button>
        <Button variant="outline" size="lg" href="/surf-lessons-tamarindo">
          Mejor una clase de surf
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .rr-hero {
    padding: 4rem 0 3rem;
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
  }
  .rr-hero-in {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .rr-lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 42ch;
    margin: 1.1rem 0 1.75rem;
  }
  .rr-hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .rr-steps {
    list-style: none;
    counter-reset: s;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .rr-steps li {
    counter-increment: s;
    position: relative;
    padding-left: 2.5rem;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .rr-steps li::before {
    content: counter(s);
    position: absolute;
    left: 0;
    top: 0;
    width: 1.75rem;
    height: 1.75rem;
    display: grid;
    place-items: center;
    background: var(--teal);
    color: #fff;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .rr-steps strong {
    color: var(--navy);
  }
  @media (max-width: 860px) {
    .rr-hero-in {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .rr-catalog {
    padding: 2.5rem 0 var(--section-pad);
  }
  .rr-cat-head {
    margin-bottom: 1.5rem;
  }
  .rr-cat-head h2 {
    margin: 0 0 0.4rem;
  }
  .rr-cat-head p {
    color: var(--text-muted);
    margin: 0;
  }
  .rr-fallback {
    max-width: 560px;
    margin: 2rem auto;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: center;
  }
  .rr-wa {
    display: inline-block;
    margin-top: 1rem;
    background: #25d366;
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .rr-final {
    padding: 3.5rem 0;
    text-align: center;
    border-top: 1px solid var(--border);
  }
  .rr-final p {
    color: var(--text-muted);
    margin: 0.5rem 0 1.5rem;
  }
  .rr-final .rr-hero-cta {
    justify-content: center;
  }
</style>
