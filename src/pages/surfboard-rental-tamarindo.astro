---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Button from '@components/ui/Button.astro';
import WhatsAppIcon from '@components/ui/WhatsAppIcon.astro';
import FaqAccordion from '@components/sections/FaqAccordion.astro';
import FAQPageSchema from '@components/seo/FAQPageSchema.astro';
import BreadcrumbSchema from '@components/seo/BreadcrumbSchema.astro';
import CatalogGrid from '@components/rentals/CatalogGrid.tsx';
import { getPageSeo } from '@lib/seo';
import { getCatalogUnits } from '@lib/queries/rentals';
import { surfboardRentalTamarindoFaqs } from '@data/faqs/surfboard-rental-tamarindo';
import { BUSINESS, SITE, absoluteUrl, whatsappUrl } from '@lib/constants';

export const prerender = false;

const seo = getPageSeo('surfboard-rental-tamarindo')!;
const units = await getCatalogUnits();
const waHref = whatsappUrl('Hi! I want to rent a surfboard in Tamarindo.');

const url = absoluteUrl('/surfboard-rental-tamarindo');
const from = units.length ? Math.min(...units.map((u) => u.price_per_day)) : 0;

// TODO: reemplazar por una foto real de la flota en la tienda.
const heroImage =
  'https://images.unsplash.com/photo-1533603208986-24fd819e718f?w=1200&q=80&auto=format&fit=crop';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Surfboard Rental in Tamarindo',
  description:
    'Rent surfboards on Tamarindo Beach: soft-tops, longboards, funboards, shortboards and fish. Daily and weekly rates. Reserve online or walk in.',
  serviceType: 'Surfboard Rental',
  url,
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: { '@type': 'Place', name: 'Tamarindo, Guanacaste, Costa Rica' },
  ...(units.length
    ? {
        offers: {
          '@type': 'AggregateOffer',
          priceCurrency: 'USD',
          lowPrice: from,
          highPrice: Math.max(...units.map((u) => u.price_per_day)),
          offerCount: units.length,
          availability: 'https://schema.org/InStock',
        },
      }
    : {}),
};

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Surfboard Rental Tamarindo', path: '/surfboard-rental-tamarindo' },
];
---

<BaseLayout seo={seo}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <FAQPageSchema faqs={surfboardRentalTamarindoFaqs} />
    <BreadcrumbSchema items={breadcrumbs} />
  </Fragment>

  <section class="rr-hero">
    <Container>
      <div class="rr-hero-in">
        <div class="rr-hero-copy">
          <Eyebrow>Alquiler de tablas · Playa Tamarindo</Eyebrow>
          <h1>Elegí tu tabla y llevátela hoy</h1>
          <p class="rr-lead">
            Softtops, longboards, funboards, shortboards y fish. Por hora, por día o por semana.
          </p>
          <div class="rr-hero-cta">
            <Button href="#tablas" size="lg">Ver las tablas</Button>
            <Button variant="whatsapp" size="lg" href={waHref} target="_blank">
              <WhatsAppIcon size={20} />
              Preguntar por WhatsApp
            </Button>
          </div>
        </div>
        <figure class="rr-hero-art">
          <img src={heroImage} alt="Tablas de surf listas para alquilar en Playa Tamarindo" width="1200" height="900" fetchpriority="high" />
          {units.length > 0 && (
            <figcaption>
              <span>desde</span>
              <strong>${from}</strong>
              <span>por día</span>
            </figcaption>
          )}
        </figure>
      </div>
    </Container>
  </section>

  <section class="rr-how">
    <Container>
      <ol class="rr-steps rr-reveal">
        <li><strong>Elegí la tabla.</strong> Filtrá por tu peso, tu nivel y tu presupuesto.</li>
        <li><strong>Mirá si está libre.</strong> Poné las fechas y la añadís a tu reserva.</li>
        <li><strong>Retirala en la playa.</strong> Documento con foto, firmás el waiver y al agua.</li>
      </ol>
    </Container>
  </section>

  <section class="rr-catalog" id="tablas">
    <Container>
      <div class="rr-cat-head">
        <h2>Todas nuestras tablas</h2>
        <p>Filtrá por lo que importa: tu nivel, tu presupuesto y el volumen que necesitás.</p>
      </div>

      {units.length > 0 ? (
        <CatalogGrid client:load units={units} />
      ) : (
        <div class="rr-fallback">
          <p>Estamos cargando la flota. Escribinos y te decimos qué tenemos libre hoy.</p>
          <a class="rr-wa" href={waHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </div>
      )}
    </Container>
  </section>

  <FaqAccordion
    faqs={surfboardRentalTamarindoFaqs}
    title="Alquiler de tablas en Tamarindo: preguntas frecuentes"
    intro="Lo que más nos preguntan antes de alquilar. Si falta la tuya, escribinos por WhatsApp."
  />

  <section class="rr-final">
    <Container>
      <h2>¿Preferís pasar por la tienda?</h2>
      <p>Estamos en {BUSINESS.address.formatted}. Abierto todos los días.</p>
      <div class="rr-hero-cta">
        <Button variant="whatsapp" size="lg" href={waHref} target="_blank">
          <WhatsAppIcon size={20} />
          Escribinos por WhatsApp
        </Button>
        <Button variant="outline" size="lg" href="/surf-lessons-tamarindo">
          Mejor una clase de surf
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .rr-hero {
    padding: 4rem 0 3.5rem;
    background: var(--bg-alt);
  }
  .rr-hero-in {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3.5rem;
    align-items: center;
  }
  .rr-lead {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 34ch;
    margin: 1.1rem 0 1.75rem;
  }
  .rr-hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  /* Foto a sangre por el borde derecho: rompe la simetría del split 50/50. */
  .rr-hero-art {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--border);
  }
  .rr-hero-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .rr-hero-art figcaption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--navy);
    color: #fff;
    font-size: 0.8rem;
    line-height: 1;
  }
  .rr-hero-art figcaption strong {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.5rem;
    color: var(--teal);
  }
  @media (max-width: 860px) {
    .rr-hero-in {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .rr-hero-art {
      order: -1;
      aspect-ratio: 16 / 9;
    }
    .rr-lead {
      max-width: none;
    }
  }

  .rr-how {
    padding: 2.25rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .rr-steps {
    list-style: none;
    counter-reset: s;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .rr-steps li {
    counter-increment: s;
    position: relative;
    padding-left: 2.6rem;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .rr-steps li::before {
    content: counter(s);
    position: absolute;
    left: 0;
    top: -0.1rem;
    width: 1.85rem;
    height: 1.85rem;
    display: grid;
    place-items: center;
    background: var(--teal);
    color: #fff;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .rr-steps strong {
    display: block;
    color: var(--navy);
  }
  @media (max-width: 780px) {
    .rr-steps {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  /* Solo se anima donde el navegador lo soporta; sin soporte, contenido visible. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .rr-reveal {
        animation: rr-rise linear both;
        animation-timeline: view();
        animation-range: entry 15% cover 30%;
      }
    }
  }
  @keyframes rr-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .rr-catalog {
    padding: 3rem 0 var(--section-pad);
  }
  .rr-cat-head {
    margin-bottom: 1.5rem;
  }
  .rr-cat-head h2 {
    margin: 0 0 0.4rem;
  }
  .rr-cat-head p {
    color: var(--text-muted);
    margin: 0;
  }
  .rr-fallback {
    max-width: 560px;
    margin: 2rem auto;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: center;
  }
  .rr-wa {
    display: inline-block;
    margin-top: 1rem;
    background: #25d366;
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .rr-final {
    padding: 3.5rem 0;
    text-align: center;
    border-top: 1px solid var(--border);
  }
  .rr-final p {
    color: var(--text-muted);
    margin: 0.5rem 0 1.5rem;
  }
  .rr-final .rr-hero-cta {
    justify-content: center;
  }
</style>
