---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Button from '@components/ui/Button.astro';
import WhatsAppIcon from '@components/ui/WhatsAppIcon.astro';
import FaqAccordion from '@components/sections/FaqAccordion.astro';
import FAQPageSchema from '@components/seo/FAQPageSchema.astro';
import BreadcrumbSchema from '@components/seo/BreadcrumbSchema.astro';
import RentalWidget from '@components/rentals/RentalWidget.tsx';
import { getPageSeo } from '@lib/seo';
import { getBoardModels, RENTAL_CATEGORIES } from '@lib/queries/rentals';
import { surfboardRentalTamarindoFaqs } from '@data/faqs/surfboard-rental-tamarindo';
import { BUSINESS, SITE, absoluteUrl, whatsappUrl } from '@lib/constants';

export const prerender = false;

const seo = getPageSeo('surfboard-rental-tamarindo')!;
const models = await getBoardModels();
const paypalClientId = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID ?? '';
const waHref = whatsappUrl('Hi! I want to rent a surfboard in Tamarindo.');

const usedCategories = RENTAL_CATEGORIES.filter((c) => models.some((m) => m.category === c.slug));

const url = absoluteUrl('/surfboard-rental-tamarindo');
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Surfboard Rental in Tamarindo',
  description:
    'Rent surfboards on Tamarindo Beach — soft-tops, longboards, funboards, shortboards and fish. Hourly, daily and weekly rates. Reserve online or walk in.',
  serviceType: 'Surfboard Rental',
  url,
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: { '@type': 'Place', name: 'Tamarindo, Guanacaste, Costa Rica' },
  ...(models.length
    ? {
        offers: models.map((m) => ({
          '@type': 'Offer',
          name: `${m.name} rental`,
          price: m.price_per_day,
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
          url: `${url}#book`,
          seller: { '@id': `${SITE.url}/#business` },
        })),
      }
    : {}),
};

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Surfboard Rental Tamarindo', path: '/surfboard-rental-tamarindo' },
];
---

<BaseLayout seo={seo}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <FAQPageSchema faqs={surfboardRentalTamarindoFaqs} />
    <BreadcrumbSchema items={breadcrumbs} />
  </Fragment>

  <section class="rr-hero">
    <Container>
      <Eyebrow>Board rental · Tamarindo Beach</Eyebrow>
      <h1>Surfboard Rental in Tamarindo</h1>
      <p class="rr-lead">
        Soft-tops for learning, longboards and funboards for cruising, shortboards and fish for
        surfers who already know their way around a wave. Rent by the hour, the day, or the week —
        reserve a specific board online or walk into our shop on the beach.
      </p>
      <div class="rr-hero-cta">
        <Button href="#book" size="lg">Check availability</Button>
        <Button variant="whatsapp" size="lg" href={waHref} target="_blank">
          <WhatsAppIcon size={20} />
          Ask on WhatsApp
        </Button>
      </div>
    </Container>
  </section>

  <section class="rr-how">
    <Container>
      <ol>
        <li><strong>Pick your dates and a board.</strong> The form shows what's actually free for your window and the total price.</li>
        <li><strong>Reserve it.</strong> Pay online now, or reserve and pay at the shop. Your board is held for you.</li>
        <li><strong>Pick up on the beach.</strong> Bring photo ID and a card for the deposit, sign the rental waiver at the counter, and go surf.</li>
      </ol>
    </Container>
  </section>

  <section class="section" id="book">
    <Container>
      <div class="rr-book-head">
        <Eyebrow>Reserve a board</Eyebrow>
        <h2>Check availability</h2>
        <p>Pick a window and see the exact boards that are free.</p>
      </div>
      {models.length > 0 ? (
        <RentalWidget
          client:visible
          paypalClientId={paypalClientId}
          categories={usedCategories.map((c) => ({ slug: c.slug, label: c.label }))}
          whatsappNumber={BUSINESS.whatsapp.number}
        />
      ) : (
        <div class="rr-fallback">
          <p>We're loading the rental fleet. Message us and we'll set you up right away.</p>
          <a class="rr-wa" href={waHref} target="_blank" rel="noopener noreferrer">WhatsApp us</a>
        </div>
      )}
      <noscript>
        <p class="rr-fallback">
          You need JavaScript to reserve online. <a href={waHref}>Message us on WhatsApp</a> instead.
        </p>
      </noscript>
    </Container>
  </section>

  {usedCategories.length > 0 && (
    <section class="section section-alt">
      <Container>
        <Eyebrow>The fleet</Eyebrow>
        <h2>Board types we rent</h2>
        <div class="rr-cats">
          {usedCategories.map((c) => (
            <a class="rr-cat" href={`/surfboard-rental-tamarindo/${c.slug}`}>
              <span class="rr-cat-name">{c.label}</span>
              <span class="rr-cat-blurb">{c.blurb}</span>
              <span class="rr-cat-go">See {c.label.toLowerCase()} →</span>
            </a>
          ))}
        </div>
      </Container>
    </section>
  )}

  <FaqAccordion
    faqs={surfboardRentalTamarindoFaqs}
    title="Surfboard Rental Tamarindo: Frequently Asked Questions"
    intro="What people ask most before renting a board. If yours isn't here, message us on WhatsApp."
  />

  <section class="rr-final">
    <Container>
      <h2>Walk in or reserve ahead</h2>
      <p>We're on Tamarindo Beach, {BUSINESS.address.formatted}. Open daily.</p>
      <div class="rr-hero-cta">
        <Button href="#book" size="lg">Reserve a board</Button>
        <Button variant="outline" size="lg" href="/surf-lessons-tamarindo">Book a lesson instead</Button>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .rr-hero {
    padding: 5rem 0 3rem;
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
  }
  .rr-lead {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 640px;
    margin: 1.25rem 0 2rem;
  }
  .rr-hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .rr-how {
    padding: 2.5rem 0;
  }
  .rr-how ol {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .rr-how li {
    counter-increment: step;
    font-size: 0.95rem;
    color: var(--text-muted);
    padding-top: 2.25rem;
    position: relative;
  }
  .rr-how li::before {
    content: counter(step);
    position: absolute;
    top: 0;
    left: 0;
    width: 1.75rem;
    height: 1.75rem;
    display: grid;
    place-items: center;
    background: var(--teal);
    color: #fff;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .rr-how li strong {
    color: var(--navy);
  }
  @media (max-width: 640px) {
    .rr-how ol {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
  .section {
    padding: var(--section-pad) 0;
  }
  .section-alt {
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
  }
  .rr-book-head {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 2rem;
  }
  .rr-book-head h2 {
    margin: 0.5rem 0 0.5rem;
  }
  .rr-book-head p {
    color: var(--text-muted);
    margin: 0;
  }
  .rr-fallback {
    max-width: 560px;
    margin: 0 auto;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: center;
  }
  .rr-wa {
    display: inline-block;
    margin-top: 1rem;
    background: #25d366;
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .rr-cats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .rr-cat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    text-decoration: none;
  }
  .rr-cat:hover {
    border-color: var(--teal);
  }
  .rr-cat-name {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--navy);
  }
  .rr-cat-blurb {
    font-size: 0.88rem;
    color: var(--text-muted);
    flex: 1;
  }
  .rr-cat-go {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--teal-dark);
  }
  .rr-final {
    padding: 3.5rem 0;
    text-align: center;
    border-top: 1px solid var(--border);
  }
  .rr-final p {
    color: var(--text-muted);
    margin: 0.5rem 0 1.5rem;
  }
  .rr-final .rr-hero-cta {
    justify-content: center;
  }
</style>
