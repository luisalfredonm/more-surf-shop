---
import '@/styles/global.css';
import SEOHead from '@components/seo/SEOHead.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import WhatsAppFloat from '@components/layout/WhatsAppFloat.astro';
import type { PageSeo } from '@lib/seo';

interface Props {
  seo: PageSeo;
  heroImage?: string;
  aggregateRating?: {
    ratingValue: number;
    reviewCount: number;
    bestRating: 5;
    worstRating: 1;
  } | null;
}

const { seo, heroImage, aggregateRating } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SEOHead seo={seo} heroImage={heroImage} aggregateRating={aggregateRating} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 0;
    background: var(--navy);
    color: var(--white);
    padding: 1rem 1.5rem;
    z-index: 9999;
    text-decoration: none;
    font-weight: 600;
  }
  .skip-link:focus {
    top: 0;
  }
</style>
